# ==========================================
# ThingsBoard Configuration
# ==========================================
THINGSBOARD_HOST=https://thingsboard.cloud
THINGSBOARD_USERNAME=your_thingsboard_email@example.com
THINGSBOARD_PASSWORD=your_thingsboard_password

# Optional: Specific Entity ID & Type if not fetching all devices
# Entity Types: DEVICE, ASSET, TENANT, etc.
THINGSBOARD_ENTITY_TYPE=DEVICE
THINGSBOARD_ENTITY_ID=

# Telemetry keys to fetch (comma-separated, leave blank for all)
THINGSBOARD_KEYS=active,voltage,current,power,status,temperature,humidity

# ==========================================
# SMTP Email Configuration
# ==========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_or_email_password
SENDER_EMAIL=your_email@gmail.com
RECIPIENT_EMAILS=recipient1@example.com,71762332038@cit.edu.in
RECIPIENT_EMAILS_5B=recipient_5b_1@example.com,recipient_5b_2@example.com
BCC_EMAILS=bcc_recipient1@example.com,bcc_recipient2@example.com
BCC_EMAILS_5B=bcc_recipient_5b@example.com

# Project Specific Settings
PROJECT_NAME=BBMP
THINGSBOARD_CUSTOMER_ID_5B=3e268290-3989-11f1-9e5f-85a6074555d7

# Email Subject Prefix & Threading
EMAIL_SUBJECT_PREFIX=[BBMP Panel Report]
EMAIL_SUBJECT_PREFIX_5B=[5B Innovation Panel Report]
ENABLE_EMAIL_THREADING=true
ENABLE_EMAIL_THREADING_5B=false
EMAIL_THREAD_ID=bbmp-panel-telemetry-report-thread@bbmp.local
EMAIL_THREAD_ID_5B=5b-innovation-panel-telemetry-report-thread@5b.local
